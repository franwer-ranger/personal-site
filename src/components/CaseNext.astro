---
import type { Project } from '../lib/data';
import { projectPath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  label: string;
  next: Project;
}

const { locale, label, next } = Astro.props;
---

<nav class="case-next" aria-label={label}>
  <a href={projectPath(locale, next.data.slug)} class="container case-next-inner">
    <span class="mono case-next-label">{label}</span>
    <span class="case-next-title">
      {next.data.title}
      <span class="arrow" aria-hidden="true">→</span>
    </span>
  </a>
</nav>

<style>
  .case-next {
    border-top: 1px solid var(--border);
    background: var(--surface-subtle);
  }

  .case-next-inner {
    display: grid;
    gap: var(--space-2);
    padding-block: var(--space-6);
  }

  .case-next-label {
    color: var(--text-subtle);
  }

  .case-next-title {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-4);
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 1.3rem + 2vw, 2.8rem);
    font-weight: 620;
    letter-spacing: -0.035em;
    transition: color var(--duration-hover) var(--ease-standard);
  }

  .case-next-title .arrow {
    transition: transform var(--duration-hover) var(--ease-standard);
  }

  @media (hover: hover) {
    .case-next:hover .case-next-title {
      color: var(--accent-strong);
    }

    .case-next:hover .arrow {
      transform: translateX(0.35rem);
    }
  }
</style>
