---
import { getTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);

const email = 'franbaraguz98@gmail.com';
const socials = [
  { label: 'GitHub', url: 'https://github.com/franwer-ranger' },
  { label: 'LinkedIn', url: 'https://www.linkedin.com/in/francisco-barahona-a9b3a3218/' },
];

---

<section class="section theme-dark contact" id="contact">
  <div class="container">
    <header class="section-head" data-reveal>
      <span class="section-index">06 · {t.sections.contact}</span>
      <p class="kicker">{t.contact.kicker}</p>
      <h2 class="display section-title contact-title">{t.contact.title}</h2>
      <p class="section-intro">{t.contact.intro}</p>
    </header>

    <div class="contact-body" data-reveal>
      <div class="contact-email">
        <span class="mono contact-label">{t.contact.emailLabel}</span>
        <a href={`mailto:${email}`} class="contact-address display">{email}</a>
      </div>

      <div class="contact-socials">
        <span class="mono contact-label">{t.contact.socialLabel}</span>
        <ul role="list" class="social-list">
          {
            socials.map((social) => (
              <li>
                <a href={social.url} class="link-arrow contact-social" target="_blank" rel="noopener noreferrer">
                  {social.label}
                  <span class="arrow" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <a href={`mailto:${email}`} class="button contact-cta">{t.contact.cta}</a>
    </div>
  </div>
</section>

<style>
  .contact-title {
    max-width: 16ch;
  }

  .contact-body {
    display: grid;
    gap: 2.5rem;
    justify-items: start;
  }

  .contact-label {
    color: var(--coal-text-soft);
    font-size: 0.68rem;
    display: block;
    margin-bottom: 0.7rem;
  }

  .contact-address {
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.6rem);
    font-weight: 480;
    letter-spacing: -0.015em;
    border-bottom: 1px solid var(--coal-line);
    padding-bottom: 0.3rem;
    transition:
      color 0.3s var(--ease-out),
      border-color 0.3s var(--ease-out);
    overflow-wrap: anywhere;
  }

  .contact-address:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .social-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
  }

  .contact-social {
    color: var(--coal-text);
    border-bottom-color: var(--coal-line);
  }

  .contact-social:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact-cta {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }

  .contact-cta:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--paper);
  }
</style>
