---
import ExternalLink from './ExternalLink.astro';
import { getTranslations, type Locale } from '../i18n/ui';
import { profile } from '../config/profile';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const email = profile.email;
// Un solo buzón para las dos conversaciones; el asunto es lo que las separa.
const mailto = (subject?: string) =>
  subject ? `mailto:${email}?subject=${encodeURIComponent(subject)}` : `mailto:${email}`;
---

<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact-grid">
    <header class="contact-head">
      <p class="kicker">{t.contact.kicker}</p>
      <h2 class="section-title" id="contact-title">{t.contact.title}</h2>
      <p class="contact-intro">{t.contact.intro}</p>
    </header>

    <ul class="contact-tracks" role="list">
      {
        t.contact.tracks.map((track, index) => (
          <li class:list={['track', { 'track--primary': index === 0 }]}>
            <h3>{track.title}</h3>
            <p>{track.description}</p>
            <a href={mailto(track.subject)} class:list={['button', { 'button--quiet': index !== 0 }]}>
              {track.cta}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="contact-details">
      <div>
        <span class="mono">{t.contact.emailLabel}</span>
        <a href={mailto()}>{email}</a>
      </div>
      <div>
        <span class="mono">{t.contact.socialLabel}</span>
        <p>
          <ExternalLink
            locale={locale}
            href={profile.linkedin}
            label="LinkedIn"
          />
          <ExternalLink locale={locale} href={profile.github} label="GitHub" />
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--accent);
    color: #fff;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .contact-head {
    grid-column: 1 / span 5;
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .contact .kicker,
  .contact .section-title {
    color: #fff;
  }

  .contact-intro {
    color: #eff0ff;
    font-size: var(--fs-lead);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .contact-tracks {
    grid-column: 6 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .track {
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: var(--radius-md);
    background: rgb(255 255 255 / 0.04);
  }

  .track--primary {
    border-color: rgb(255 255 255 / 0.72);
    background: rgb(255 255 255 / 0.12);
  }

  .track h3 {
    font-size: 1.1rem;
  }

  .track p {
    color: #eff0ff;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .contact .button {
    border-color: #fff;
    background: #fff;
    color: var(--accent-strong);
  }

  .contact .button--quiet {
    min-height: auto;
    padding: 0;
    border: 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.55);
    border-radius: 0;
    background: transparent;
    color: #fff;
  }

  .contact-details {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-6);
    padding-top: var(--space-4);
    border-top: 1px solid rgb(255 255 255 / 0.3);
  }

  .contact-details > div {
    display: grid;
    gap: var(--space-2);
  }

  .contact-details .mono {
    color: #eff0ff;
  }

  .contact-details :global(a) {
    font-weight: 620;
    overflow-wrap: anywhere;
  }

  .contact-details p {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  @media (hover: hover) {
    .contact .button:hover {
      border-color: var(--play);
      background: var(--play);
      color: var(--text);
    }

    .contact .button--quiet:hover {
      border-color: #fff;
      background: transparent;
      color: #fff;
    }

    .contact-details :global(a:hover) {
      text-decoration: underline;
      text-underline-offset: 0.2rem;
    }
  }

  @media (max-width: 56rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .contact-head,
    .contact-tracks,
    .contact-details {
      grid-column: 1;
    }
  }

  @media (max-width: 38rem) {
    .contact-tracks {
      grid-template-columns: 1fr;
    }
  }
</style>
