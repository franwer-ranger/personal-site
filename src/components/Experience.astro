---
import type { CollectionEntry } from 'astro:content';
import { getTranslations, projectPath, fill, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  experience: CollectionEntry<'experience'>[];
}

const { locale, experience } = Astro.props;
const t = getTranslations(locale);
---

<section class="section experience" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <header class="section-head experience-head">
      <p class="kicker">{t.experience.kicker}</p>
      <h2 class="section-title" id="experience-title">{t.experience.title}</h2>
      <p class="section-intro">{t.experience.evolutionNote}</p>
    </header>

    <ol class="experience-list" role="list">
      {
        experience.map((entry, index) => (
          <li class="experience-card">
            <div class="experience-meta">
              <span class="mono">0{index + 1}</span>
              <span class="mono">{entry.data.period}</span>
            </div>
            <div class="experience-main">
              <p class="company">{entry.data.company}</p>
              <h3>{entry.data.role}</h3>
              <p class="summary">{entry.data.summary}</p>
            </div>
            <div class="experience-footer">
              <ul class="technology-list" role="list">
                {entry.data.technologies.slice(0, 3).map((technology) => <li>{technology}</li>)}
              </ul>
              <a class="link-arrow" href={projectPath(locale, entry.data.slug)}>
                {fill(t.selectedWork.caseCta, { project: entry.data.company })}
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .experience {
    background: var(--surface-subtle);
  }

  .experience-head {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
  }

  .experience-head .kicker,
  .experience-head .section-title {
    grid-column: 1 / span 6;
  }

  .experience-head .section-intro {
    grid-column: 8 / -1;
    grid-row: 1 / span 2;
  }

  .experience-list {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--border);
  }

  .experience-card {
    display: grid;
    grid-template-columns: minmax(8rem, 0.8fr) minmax(0, 2fr) minmax(12rem, 1.15fr);
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .experience-card:first-child {
    border-top: 0;
  }

  .experience-card:last-child {
    border-top: 0;
  }

  .experience-meta,
  .experience-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .experience-meta {
    display: grid;
    justify-content: start;
    color: var(--text-subtle);
  }

  .experience-main {
    display: grid;
    gap: var(--space-2);
  }

  .company {
    color: var(--accent-strong);
    font-weight: 650;
  }

  .experience-main h3 {
    font-size: var(--fs-h3);
    line-height: 1.15;
  }

  .summary {
    color: var(--text-muted);
    line-height: 1.55;
  }

  .experience-footer {
    display: grid;
    justify-items: start;
    justify-content: stretch;
    gap: var(--space-3);
    align-items: flex-end;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .technology-list li {
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: var(--surface-subtle);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  @media (max-width: 52rem) {
    .experience-head {
      grid-template-columns: 1fr;
    }

    .experience-head .kicker,
    .experience-head .section-title,
    .experience-head .section-intro {
      grid-column: 1;
      grid-row: auto;
    }

    .experience-list {
      display: grid;
    }

    .experience-card {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  @media (max-width: 34rem) {
    .experience-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
