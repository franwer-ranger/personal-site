---
import type { CollectionEntry } from 'astro:content';
import { getTranslations, projectPath, fill, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  experience: CollectionEntry<'experience'>[];
}

const { locale, experience } = Astro.props;
const t = getTranslations(locale);
---

<section class="section experience" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <header class="section-head experience-head">
      <p class="kicker">{t.experience.kicker}</p>
      <h2 class="section-title" id="experience-title">{t.experience.title}</h2>
      <p class="section-intro">{t.experience.evolutionNote}</p>
    </header>

    <ol class="experience-list" role="list">
      {
        experience.map((entry, index) => (
          <li class="experience-card">
            <div class="experience-meta">
              <span class="mono">0{index + 1}</span>
              <span class="mono">{entry.data.period}</span>
            </div>
            <div class="experience-main">
              <p class="company">{entry.data.company}</p>
              <h3>{entry.data.role}</h3>
              <p class="summary">{entry.data.summary}</p>
            </div>
            <div class="experience-evidence">
              <p class="mono evidence-label">{t.experience.evidence}</p>
              <ul role="list">
                {entry.data.highlights.slice(0, 3).map((highlight) => <li>{highlight}</li>)}
              </ul>
            </div>
            <div class="experience-footer">
              <ul class="technology-list" role="list">
                {entry.data.technologies.slice(0, 3).map((technology) => <li>{technology}</li>)}
              </ul>
              <a class="link-arrow" href={projectPath(locale, entry.data.slug)}>
                {fill(t.selectedWork.caseCta, { project: entry.data.company })}
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .experience {
    background: var(--surface-subtle);
  }

  .experience-head {
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: end;
  }

  .experience-head .kicker,
  .experience-head .section-title {
    grid-column: 1 / span 6;
  }

  .experience-head .section-intro {
    grid-column: 8 / -1;
    grid-row: 1 / span 2;
  }

  .experience-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .experience-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-5);
    padding: clamp(1.35rem, 1rem + 1.5vw, 2.25rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .experience-card:first-child {
    border-top: 4px solid var(--accent);
  }

  .experience-card:last-child {
    border-top: 4px solid var(--text);
  }

  .experience-meta,
  .experience-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .experience-meta {
    color: var(--text-subtle);
  }

  .experience-main {
    display: grid;
    gap: var(--space-2);
  }

  .company {
    color: var(--accent-strong);
    font-weight: 650;
  }

  .experience-main h3 {
    font-size: var(--fs-h3);
    line-height: 1.15;
  }

  .summary {
    color: var(--text-muted);
    line-height: 1.55;
  }

  .experience-evidence {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .evidence-label {
    color: var(--text-subtle);
  }

  .experience-evidence ul {
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .experience-evidence li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .experience-evidence li::before {
    content: '';
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 0.45rem;
    height: 2px;
    background: var(--accent);
  }

  .experience-footer {
    align-items: flex-end;
  }

  .technology-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .technology-list li {
    padding: 0.3rem 0.55rem;
    border-radius: 999px;
    background: var(--surface-subtle);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  @media (max-width: 52rem) {
    .experience-head {
      grid-template-columns: 1fr;
    }

    .experience-head .kicker,
    .experience-head .section-title,
    .experience-head .section-intro {
      grid-column: 1;
      grid-row: auto;
    }

    .experience-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34rem) {
    .experience-footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
