---
import ExternalLink from './ExternalLink.astro';
import { profile } from '../config/profile';
import { getTranslations, getLocalizedPath, homePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const home = homePath(locale);
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const year = new Date().getFullYear();
const email = profile.email;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <img src="/silhouette.svg" alt="" width="28" height="35" aria-hidden="true" />
      <div>
        <strong>Fran Barahona</strong>
        <span>{t.nav.brandRole}</span>
      </div>
    </div>

    <nav aria-label={t.nav.ariaLabel} class="footer-nav">
      <a href={`${home}#experience`}>{t.nav.experience}</a>
      <a href={`${home}#work`}>{t.nav.work}</a>
      <a href={`${home}#lab`}>{t.nav.lab}</a>
      <a href={`${home}#contact`}>{t.nav.contact}</a>
    </nav>

    <div class="footer-links">
      <a href={`mailto:${email}`}>{email}</a>
      <ExternalLink
        locale={locale}
        href={profile.linkedin}
        label="LinkedIn"
      />
      <ExternalLink locale={locale} href={profile.github} label="GitHub" />
      <a href={getLocalizedPath(Astro.url.pathname, otherLocale)} hreflang={otherLocale}>
        {t.languageNames[otherLocale]}
      </a>
    </div>

    <div class="footer-bottom mono">
      <span>{t.footer.built}</span>
      <span>{t.footer.stack}</span>
      <span>© {year} · {t.footer.rights}</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
    background: var(--surface);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .footer-brand {
    grid-column: 1 / span 4;
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .footer-brand img {
    width: 1.5rem;
  }

  .footer-brand div {
    display: grid;
  }

  .footer-brand span {
    color: var(--text-subtle);
    font-size: 0.86rem;
  }

  .footer-nav,
  .footer-links {
    display: grid;
    align-content: start;
    gap: var(--space-2);
  }

  .footer-nav {
    grid-column: 6 / span 2;
  }

  .footer-links {
    grid-column: 9 / -1;
  }

  .footer-nav a,
  .footer-links :global(a) {
    color: var(--text-muted);
  }

  .footer-links a:first-child {
    overflow-wrap: anywhere;
    color: var(--accent-strong);
  }

  .footer-bottom {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    color: var(--text-subtle);
    font-size: 0.65rem;
  }

  @media (hover: hover) {
    .footer-nav a:hover,
    .footer-links :global(a:hover) {
      color: var(--accent-strong);
    }
  }

  @media (max-width: 44rem) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }

    .footer-nav,
    .footer-links {
      grid-column: auto;
    }

    .footer-bottom {
      grid-column: 1 / -1;
      flex-direction: column;
    }
  }
</style>
