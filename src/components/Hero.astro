---
import { getTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<div class="hero-pin" data-hero-pin>
<section class="hero" data-hero>
  <canvas class="hero-canvas" data-hero-canvas role="img" aria-label={t.hero.sceneLabel}></canvas>
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="container hero-content">
    <p class="kicker" data-reveal>{t.hero.kicker}</p>
    <h1 class="display hero-title" data-reveal data-reveal-delay="80">{t.hero.title}</h1>
    <p class="hero-subtitle" data-reveal data-reveal-delay="160">{t.hero.subtitle}</p>
    <div class="hero-ctas" data-reveal data-reveal-delay="240">
      <a href="#work" class="button">{t.hero.ctaPrimary}</a>
      <a href="#contact" class="button button--ghost">{t.hero.ctaSecondary}</a>
    </div>
  </div>

  <div class="hero-scroll" aria-hidden="true">
    <span class="mono hero-scroll-label">{t.hero.scrollHint}</span>
    <span class="hero-scroll-line"><span></span></span>
  </div>
</section>
</div>

<style>
  /*
   * The wrapper is taller than the hero; the hero sticks to the top while the
   * extra height scrolls by, so the scroll gesture visibly orders the system
   * and the resolved lattice stays on screen. Plain sticky — the scroll never
   * stops, content just arrives ~one gesture later.
   */
  .hero-pin {
    --hero-pin-extra: 85svh;
    min-height: calc(100svh + var(--hero-pin-extra));
  }

  .hero {
    position: sticky;
    top: 0;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: clip;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Keeps text legible without hiding the scene. */
  .hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--paper) 82%, transparent) 0%,
      color-mix(in srgb, var(--paper) 45%, transparent) 45%,
      transparent 75%
    );
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: 7rem 5rem;
    display: grid;
    gap: 1.6rem;
    justify-items: start;
  }

  .hero-title {
    font-size: var(--fs-hero);
    font-weight: 470;
    max-width: 14ch;
    text-wrap: balance;
  }

  .hero-subtitle {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    max-width: 46ch;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 0.6rem;
  }

  .hero-scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    /* Fades as the system orders (--hero-order is set from the scene). */
    opacity: calc(1 - var(--hero-order, 0) * 1.6);
  }

  .hero-scroll-label {
    color: var(--ink-faint);
    font-size: 0.62rem;
  }

  .hero-scroll-line {
    width: 1px;
    height: 3rem;
    background: var(--line-strong);
    overflow: hidden;
    display: block;
  }

  .hero-scroll-line span {
    display: block;
    width: 100%;
    height: 40%;
    background: var(--accent);
    animation: scroll-drip 2.2s var(--ease-out) infinite;
  }

  @keyframes scroll-drip {
    0% {
      transform: translateY(-110%);
    }
    60%,
    100% {
      transform: translateY(260%);
    }
  }

  @media (max-width: 48rem) {
    .hero-pin {
      --hero-pin-extra: 60svh;
    }

    .hero-veil {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--paper) 88%, transparent) 0%,
        color-mix(in srgb, var(--paper) 62%, transparent) 60%,
        color-mix(in srgb, var(--paper) 35%, transparent) 100%
      );
    }

    .hero-content {
      padding-block: 6.5rem 6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    /* No pin: the scene renders a static ordered frame, nothing to drive. */
    .hero-pin {
      --hero-pin-extra: 0svh;
    }

    .hero-scroll-line span {
      animation: none;
    }
  }
</style>

<script>
  async function bootHero() {
    const section = document.querySelector<HTMLElement>('[data-hero]');
    const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (!section || !canvas) return;

    let dispose: (() => void) | undefined;
    let swapped = false;
    document.addEventListener(
      'astro:before-swap',
      () => {
        swapped = true;
        dispose?.();
      },
      { once: true },
    );

    // Three.js loads in its own chunk, deferred off the critical path.
    const { initHeroScene } = await import('../lib/heroScene');
    if (!swapped) dispose = initHeroScene(canvas, section);
  }

  document.addEventListener('astro:page-load', () => {
    void bootHero();
  });
</script>
