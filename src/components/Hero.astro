---
import { getTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="kicker">{t.hero.kicker}</p>
      <h1 class="display hero-title" id="hero-title">
        <span>Fran Barahona</span>
        {t.hero.title}
      </h1>
      <p class="hero-subtitle">{t.hero.subtitle}</p>
      <p class="hero-context">{t.hero.context}</p>
      <div class="hero-ctas">
        <a href="#experience" class="button">{t.hero.ctaPrimary}</a>
        <a href="#contact" class="button button--ghost">{t.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="build-trace" aria-label={t.hero.traceLabel}>
      <p class="mono trace-label">{t.hero.traceLabel}</p>
      <ol class="trace-list" role="list">
        {
          t.hero.trace.map((step, index) => (
            <li class="trace-step">
              <span class="trace-number mono" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span>{step}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(7.5rem, 12vh, 9.5rem) clamp(3rem, 6vh, 4.5rem);
    min-height: min(47rem, 82svh);
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
    align-items: center;
  }

  .hero-copy {
    grid-column: 1 / span 7;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
  }

  .hero-title {
    display: grid;
    gap: var(--space-2);
    max-width: 10ch;
    color: var(--text);
    font-size: var(--fs-hero);
    font-weight: 680;
  }

  .hero-title span {
    color: var(--text-muted);
    font-size: 0.28em;
    font-weight: 540;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .hero-subtitle {
    max-width: 49ch;
    color: var(--text-muted);
    font-size: var(--fs-lead);
    line-height: 1.48;
    text-wrap: pretty;
  }

  .hero-context {
    color: var(--text-subtle);
    font-size: 0.95rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .build-trace {
    grid-column: 9 / -1;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .trace-label {
    margin-bottom: var(--space-4);
    color: var(--text-subtle);
  }

  .trace-list {
    display: grid;
  }

  .trace-step {
    position: relative;
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: var(--space-3);
    align-items: center;
    min-height: 3.25rem;
    color: var(--text-muted);
    font-weight: 570;
  }

  .trace-step:not(:last-child)::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: calc(50% + 0.7rem);
    bottom: calc(-50% + 0.7rem);
    left: 0.68rem;
    width: 1px;
    background: var(--border-strong);
  }

  .trace-number {
    position: relative;
    z-index: 1;
    display: grid;
    width: 1.4rem;
    height: 1.4rem;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 50%;
    background: var(--surface);
    color: var(--accent-strong);
    font-size: 0.58rem;
  }

  .trace-step:last-child .trace-number {
    border-color: var(--play);
    background: var(--play);
    color: var(--text);
  }

  @media (max-width: 52rem) {
    .hero {
      min-height: auto;
      padding-block: 7.5rem 3.25rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .hero-copy,
    .build-trace {
      grid-column: 1;
    }

    .build-trace {
      max-width: 34rem;
    }
  }

  @media (max-width: 30rem) {
    .hero-copy {
      gap: 1.15rem;
    }

    .hero-title {
      font-size: clamp(2.65rem, 12vw, 3.55rem);
    }

    .hero-ctas {
      width: 100%;
    }

    .hero-ctas .button {
      flex: 1 1 9rem;
    }
  }
</style>
