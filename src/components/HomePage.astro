---
import type { Locale } from '../i18n/ui';
import { getProfessionalCases, getLabProjects, getExperience } from '../lib/data';
import Layout from '../layouts/Layout.astro';
import Hero from './Hero.astro';
import ProofSnapshot from './ProofSnapshot.astro';
import Experience from './Experience.astro';
import SelectedWork from './SelectedWork.astro';
import ProductAiMethod from './ProductAiMethod.astro';
import LabProjects from './LabProjects.astro';
import Contact from './Contact.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [cases, labProjects, experience] = await Promise.all([
  getProfessionalCases(locale),
  getLabProjects(locale),
  getExperience(locale),
]);
---

<Layout>
  <Hero locale={locale} />
  <ProofSnapshot locale={locale} />
  <Experience locale={locale} experience={experience} />
  <SelectedWork locale={locale} cases={cases} />
  <ProductAiMethod locale={locale} />
  <LabProjects locale={locale} projects={labProjects} />
  <Contact locale={locale} />
</Layout>
