---
import type { LabProject } from '../lib/data';
import { getTranslations, type Locale } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';

interface Props {
  locale: Locale;
  projects: LabProject[];
}

const { locale, projects } = Astro.props;
const t = getTranslations(locale);
---

<section class="section lab" id="lab" aria-labelledby="lab-title">
  <div class="container lab-layout">
    <header class="section-head lab-head">
      <p class="kicker">{t.projects.kicker}</p>
      <h2 class="section-title" id="lab-title">{t.projects.title}</h2>
      <p class="section-intro">{t.projects.intro}</p>
    </header>
    <div class="lab-grid">
      {projects.map((project, index) => <ProjectCard project={project} locale={locale} index={index} />)}
    </div>
  </div>
</section>

<style>
  .lab {
    background:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px),
      var(--play-soft);
    background-size: 3rem 3rem;
  }

  .lab-layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .lab-head {
    grid-column: 1 / span 4;
    align-content: start;
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .lab-head .section-title {
    max-width: none;
  }

  .lab-head .section-intro {
    font-size: 1rem;
  }

  .lab-grid {
    grid-column: 5 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  @media (max-width: 52rem) {
    .lab-layout {
      grid-template-columns: 1fr;
    }

    .lab-head,
    .lab-grid {
      grid-column: 1;
    }
  }

  @media (max-width: 42rem) {
    .lab-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
