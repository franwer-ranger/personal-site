---
import { getTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="section method" id="method" aria-labelledby="method-title">
  <div class="container method-layout">
    <header class="section-head method-head">
      <p class="kicker">{t.principles.kicker}</p>
      <h2 class="section-title" id="method-title">{t.principles.title}</h2>
    </header>

    <ol class="method-steps" role="list">
      {
        t.principles.items.map((item, index) => (
          <li>
            <span class="method-number mono">0{index + 1}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <aside class="artifacts" aria-labelledby="artifacts-title">
      <p class="mono" id="artifacts-title">{t.principles.artifactsLabel}</p>
      <ul role="list">
        {
          t.principles.artifacts.map((artifact) => (
            <li>
              <p class="artifact-type mono">{artifact.type}</p>
              <h3>{artifact.title}</h3>
              <code>{artifact.excerpt}</code>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</section>

<style>
  .method {
    overflow: clip;
    background: var(--inverse);
    color: var(--inverse-text);
  }

  .method-layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .method-head {
    grid-column: 1 / span 4;
    align-content: start;
  }

  .method-head .kicker {
    color: #aab1ff;
  }

  .method-head .section-title {
    color: var(--inverse-text);
  }

  .method-steps {
    grid-column: 5 / -1;
    display: grid;
  }

  .method-steps li {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-4);
    padding-block: 0 var(--space-6);
  }

  .method-steps li:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 1.75rem;
    bottom: 0.5rem;
    left: 1.35rem;
    width: 1px;
    background: rgb(247 248 251 / 0.24);
  }

  .method-number {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid #737ee9;
    border-radius: 50%;
    background: var(--inverse);
    color: #c8ccff;
  }

  .method-steps li > div {
    display: grid;
    gap: var(--space-2);
  }

  .method-steps h3 {
    font-size: var(--fs-h3);
  }

  .method-steps p {
    max-width: 57ch;
    color: var(--inverse-muted);
    line-height: 1.6;
  }

  .artifacts {
    grid-column: 5 / -1;
    display: grid;
    gap: var(--space-4);
    padding: var(--space-5);
    border: 1px solid rgb(247 248 251 / 0.18);
    border-radius: var(--radius-md);
    background: var(--inverse-surface);
  }

  .artifacts > p {
    color: #c8ccff;
  }

  .artifacts ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .artifacts li {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    min-width: 0;
    padding: var(--space-3);
    border: 1px solid var(--inverse-line);
    border-radius: var(--radius-sm);
    background: rgb(247 248 251 / 0.035);
  }

  .artifacts li:last-child {
    grid-column: 1 / -1;
  }

  .artifact-type {
    color: #aab1ff;
  }

  .artifacts h3 {
    font-size: 0.96rem;
  }

  .artifacts code {
    overflow-wrap: anywhere;
    color: var(--inverse-muted);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.55;
  }

  @media (max-width: 52rem) {
    .method-layout {
      grid-template-columns: 1fr;
    }

    .method-head,
    .method-steps,
    .artifacts {
      grid-column: 1;
    }
  }

  @media (max-width: 36rem) {
    .artifacts ul {
      grid-template-columns: 1fr;
    }

    .artifacts li:last-child {
      grid-column: 1;
    }
  }
</style>
