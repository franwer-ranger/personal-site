---
import type { LabProject } from '../lib/data';
import ProjectLogo from './ProjectLogo.astro';
import { getTranslations, projectPath, type Locale } from '../i18n/ui';

interface Props {
  project: LabProject;
  locale: Locale;
  index: number;
}

const { project, locale, index } = Astro.props;
const t = getTranslations(locale);
const { data } = project;
---

<article class="lab-card" style={`--theme: var(--theme-${data.visualTheme})`}>
  <div class="lab-card-top">
    <span class="mono lab-index">0{index + 1}</span>
    <span class="lab-status mono">{data.status}</span>
  </div>
  <div class="lab-card-title">
    {data.logo && <ProjectLogo src={data.logo} size="sm" />}
    <h3>{data.title}</h3>
  </div>
  <p>{data.summary}</p>
  <div class="lab-card-foot">
    <span class="lab-signal">{t.projects.signals[data.signal]}</span>
    <a href={projectPath(locale, data.slug)} aria-label={`${t.projects.viewProject}: ${data.title}`}>
      {t.projects.viewProject}<span aria-hidden="true"> →</span>
    </a>
  </div>
</article>

<style>
  .lab-card {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: 0 1px 0 rgb(17 19 26 / 0.05);
    transition:
      border-color var(--duration-hover) var(--ease-standard),
      transform var(--duration-hover) var(--ease-standard);
  }

  .lab-card:nth-child(even) {
    margin-top: var(--space-5);
  }

  .lab-card-top,
  .lab-card-title,
  .lab-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .lab-index {
    color: var(--theme);
  }

  .lab-status {
    padding: 0.25rem 0.5rem;
    border-radius: 999px;
    background: var(--play-soft);
    color: #2e4711;
    font-size: 0.63rem;
  }

  .lab-card-title {
    justify-content: flex-start;
  }

  .lab-card-title h3 {
    font-size: var(--fs-h3);
    line-height: 1.15;
  }

  .lab-card > p {
    color: var(--text-muted);
    font-size: 0.96rem;
    line-height: 1.55;
  }

  .lab-card-foot {
    padding-top: var(--space-3);
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }

  .lab-signal {
    color: var(--text-subtle);
  }

  .lab-card-foot a {
    color: var(--accent-strong);
    font-weight: 650;
  }

  @media (hover: hover) {
    .lab-card:hover {
      border-color: var(--theme);
      transform: translateY(-0.2rem);
    }
  }

  @media (max-width: 42rem) {
    .lab-card:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
