---
import { getImageSize } from '../lib/imageMeta';
import { getTranslations, type Locale } from '../i18n/ui';

interface Shot {
  src: string;
  alt: string;
  caption: string;
}

interface Props {
  locale: Locale;
  shots: Shot[];
}

const { locale, shots } = Astro.props;
const t = getTranslations(locale);

const items = await Promise.all(
  shots.map(async (shot, i) => {
    const { width, height } = await getImageSize(shot.src);
    return {
      ...shot,
      base: shot.src.replace(/\.png$/, ''),
      width,
      height,
      index: String(i + 1).padStart(2, '0'),
      portrait: height > width,
    };
  }),
);

const total = String(items.length).padStart(2, '0');
---

<section class="gallery" aria-labelledby="gallery-title" data-gallery>
  <div class="gallery-head">
    <h2 class="block-title mono" id="gallery-title">{t.projectPage.gallery}</h2>

    <div class="gallery-controls">
      <p class="gallery-hint">{t.gallery.hint}</p>
      <p class="gallery-counter mono" aria-live="polite" data-gallery-counter>
        <span data-gallery-current>01</span> / {total}
      </p>
      <div class="gallery-arrows">
        <button type="button" class="gallery-arrow" aria-label={t.gallery.prev} data-gallery-prev>
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" class="gallery-arrow" aria-label={t.gallery.next} data-gallery-next>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <ul class="gallery-track" role="list" tabindex="0" data-gallery-track>
    {
      items.map((item) => (
        <li class="shot" style={`--ar: ${item.width / item.height}`}>
          <figure class="shot-figure">
            <button
              type="button"
              class="shot-frame"
              aria-label={`${t.gallery.zoom}: ${item.caption}`}
              data-gallery-open
            >
              <picture>
                <source srcset={`${item.base}.avif`} type="image/avif" />
                <source srcset={`${item.base}.webp`} type="image/webp" />
                <img
                  src={item.src}
                  alt={item.alt}
                  width={item.width}
                  height={item.height}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </button>
            <figcaption class="shot-caption">
              <span class="shot-index mono">{item.index}</span>
              {item.caption}
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <dialog class="lightbox" aria-label={t.projectPage.gallery} data-gallery-dialog>
    <div class="lightbox-inner">
      <button type="button" class="lightbox-close" aria-label={t.gallery.close} data-gallery-close>
        <span aria-hidden="true">✕</span>
      </button>

      <button
        type="button"
        class="lightbox-arrow lightbox-arrow--prev"
        aria-label={t.gallery.prev}
        data-gallery-lb-prev
      >
        <span aria-hidden="true">←</span>
      </button>

      <figure class="lightbox-figure">
        <picture>
          <source type="image/avif" data-gallery-lb-avif />
          <source type="image/webp" data-gallery-lb-webp />
          <img alt="" data-gallery-lb-img />
        </picture>
        <figcaption class="lightbox-caption">
          <span data-gallery-lb-caption></span>
          <span class="mono lightbox-counter" data-gallery-lb-counter></span>
        </figcaption>
      </figure>

      <button
        type="button"
        class="lightbox-arrow lightbox-arrow--next"
        aria-label={t.gallery.next}
        data-gallery-lb-next
      >
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </dialog>

  <script is:inline type="application/json" data-gallery-data set:html={JSON.stringify(items)} />
</section>

<style>
  /* The strip breaks out of the 52rem reading column and bleeds to the right
     edge: it reads as a filmstrip you can keep pulling, not a boxed widget. */
  .gallery {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    --edge: max(var(--gutter), calc(50vw - 26rem));
    --shot-height: clamp(15rem, 11rem + 20vw, 26rem);
  }

  .gallery-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding-inline: var(--edge);
    margin-bottom: 1.6rem;
  }

  .gallery-controls {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .gallery-hint {
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .gallery-counter {
    color: var(--ink-faint);
    font-size: 0.68rem;
    font-variant-numeric: tabular-nums;
  }

  .gallery-arrows {
    display: flex;
    gap: 0.4rem;
  }

  .gallery-arrow {
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-size: 0.9rem;
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out),
      border-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      opacity 0.25s var(--ease-out);
  }

  .gallery-arrow:hover:not(:disabled) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .gallery-arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* Without JS the arrows do nothing, but the track still scrolls by hand. */
  :global(.no-js) .gallery-arrows {
    display: none;
  }

  .gallery-track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-left: var(--edge);
    padding-inline: var(--edge);
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }

  .gallery-track::-webkit-scrollbar {
    display: none;
  }

  .gallery-track:focus-visible {
    outline-offset: -2px;
  }

  .shot {
    scroll-snap-align: start;
    flex: 0 0 auto;
    /* Every shot shares the strip height and takes its width from its own
       proportion, so desktop and mobile captures line up on one baseline. */
    --shot-width: calc(var(--shot-height) * var(--ar));
  }

  .shot-figure {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    /* The caption gets a floor so a narrow phone capture doesn't squeeze it
       into a one-word column. */
    width: max(var(--shot-width), 13rem);
  }

  .shot-frame {
    display: block;
    width: var(--shot-width);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 3px;
    background: var(--paper-raised);
    overflow: hidden;
    cursor: zoom-in;
    transition:
      border-color 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  .shot-frame img {
    width: 100%;
    height: auto;
  }

  .shot-frame:hover {
    border-color: color-mix(in srgb, var(--theme) 45%, var(--line));
    box-shadow: 0 12px 28px -18px color-mix(in srgb, var(--ink) 55%, transparent);
    transform: translateY(-3px);
  }

  .shot-caption {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: 0.86rem;
    line-height: 1.45;
    color: var(--ink-soft);
    text-wrap: pretty;
    max-width: 24rem;
  }

  .shot-index {
    color: var(--theme);
    font-size: 0.62rem;
    flex-shrink: 0;
  }

  /* ---------- Lightbox ---------- */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: color-mix(in srgb, var(--coal) 94%, transparent);
    color: var(--coal-text);
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--coal) 88%, transparent);
  }

  /* minmax(0, 1fr) on both axes is what actually caps the figure: a plain 1fr
     row sizes to its content, so the image would overflow the viewport. */
  .lightbox-inner {
    height: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    gap: clamp(0.5rem, 2vw, 2rem);
    padding: clamp(3.5rem, 6vh, 5rem) clamp(0.75rem, 3vw, 2.5rem);
  }

  .lightbox-figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-width: 0;
    min-height: 0;
    height: 100%;
  }

  .lightbox-figure picture {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 1 1 auto;
    min-height: 0;
    max-width: 100%;
  }

  .lightbox-figure img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 3px;
  }

  .lightbox-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.9rem;
    font-size: 0.9rem;
    color: var(--coal-text-soft);
    text-align: center;
    text-wrap: pretty;
  }

  .lightbox-counter {
    font-size: 0.62rem;
    color: var(--coal-text-soft);
    font-variant-numeric: tabular-nums;
  }

  .lightbox-close,
  .lightbox-arrow {
    display: grid;
    place-items: center;
    border: 1px solid var(--coal-line);
    border-radius: 999px;
    background: transparent;
    color: var(--coal-text);
    cursor: pointer;
    transition:
      background-color 0.25s var(--ease-out),
      color 0.25s var(--ease-out),
      opacity 0.25s var(--ease-out);
  }

  .lightbox-arrow {
    width: 2.8rem;
    height: 2.8rem;
    font-size: 1rem;
  }

  .lightbox-close {
    position: absolute;
    top: clamp(0.75rem, 2vh, 1.5rem);
    right: clamp(0.75rem, 3vw, 2.5rem);
    width: 2.5rem;
    height: 2.5rem;
    font-size: 0.85rem;
  }

  .lightbox-close:hover,
  .lightbox-arrow:hover:not(:disabled) {
    background: var(--coal-text);
    color: var(--coal);
  }

  .lightbox-arrow:disabled {
    opacity: 0.25;
    cursor: default;
  }

  /* Too narrow for side arrows: they drop below the image, side by side and in
     reading order — the DOM order is prev, figure, next, so both need placing. */
  @media (max-width: 34rem) {
    .lightbox-inner {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 1.25rem 1rem;
    }

    .lightbox-figure {
      grid-row: 1;
      grid-column: 1 / -1;
    }

    .lightbox-arrow--prev {
      grid-row: 2;
      grid-column: 1;
      justify-self: end;
    }

    .lightbox-arrow--next {
      grid-row: 2;
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
