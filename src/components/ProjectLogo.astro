---
import { getImageSize } from '../lib/imageMeta';

interface Props {
  src: string;
  size?: 'sm' | 'md';
}

const { src, size = 'md' } = Astro.props;
const { width, height } = await getImageSize(src);
const base = src.replace(/\.png$/, '');
---

<picture class:list={['project-logo', `project-logo--${size}`]}>
  <source srcset={`${base}.avif`} type="image/avif" />
  <source srcset={`${base}.webp`} type="image/webp" />
  <img
    src={src}
    alt=""
    width={width}
    height={height}
    decoding="async"
    aria-hidden="true"
  />
</picture>

<style>
  .project-logo {
    display: block;
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 22%;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 1px 2px rgb(27 24 19 / 0.06);
  }

  .project-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-logo--sm {
    width: 2.25rem;
    height: 2.25rem;
  }

  .project-logo--md {
    width: 3.25rem;
    height: 3.25rem;
  }
</style>
