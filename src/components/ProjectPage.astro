---
import type { CollectionEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectGallery from './ProjectGallery.astro';
import ProjectLogo from './ProjectLogo.astro';
import { getTranslations, projectPath, homePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  project: CollectionEntry<'projects'>;
  next: CollectionEntry<'projects'> | undefined;
}

const { locale, project, next } = Astro.props;
const t = getTranslations(locale);
const { data } = project;
const backAnchor = data.kind === 'professional' ? 'experience' : 'work';
---

<Layout title={`${data.title} — Fran Barahona`} description={data.summary}>

  <article class="project-page" style={`--theme: var(--theme-${data.visualTheme})`}>
    <header class="project-hero">
      <div class="container project-hero-inner">
        <a href={`${homePath(locale)}#${backAnchor}`} class="link-arrow project-back" data-reveal>
          <span class="arrow flip" aria-hidden="true">←</span>
          {t.projectPage.back}
        </a>

        <div class="project-head" data-reveal data-reveal-delay="60">
          {
            data.logo ? (
              <div class="project-brand">
                <ProjectLogo src={data.logo} size="md" />
                <div class="project-brand-text">
                  <span class="mono project-category">{t.projects.kinds[data.kind]} · {t.projects.signals[data.signal]}</span>
                  <h1 class="display project-title">{data.title}</h1>
                </div>
              </div>
            ) : (
              <>
                <span class="mono project-category">{t.projects.kinds[data.kind]} · {t.projects.signals[data.signal]}</span>
                <h1 class="display project-title">{data.title}</h1>
              </>
            )
          }
          <p class="project-summary">{data.summary}</p>
        </div>

        <dl class="project-meta" data-reveal data-reveal-delay="120">
          <div>
            <dt class="mono">{t.projectPage.status}</dt>
            <dd>{data.status}</dd>
          </div>
          <div>
            <dt class="mono">{t.projectPage.year}</dt>
            <dd>{data.year}</dd>
          </div>
          <div>
            <dt class="mono">{t.projectPage.role}</dt>
            <dd>{data.role}</dd>
          </div>
          {
            data.links && data.links.length > 0 && (
              <div>
                <dt class="mono">{t.projectPage.links}</dt>
                <dd>
                  {data.links.map((link) => (
                    <a href={link.url} class="project-link" target="_blank" rel="noopener noreferrer">
                      {link.label} ↗
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    <div class="container project-body">
      <section class="project-block project-context" data-reveal>
        <div class="context-item">
          <h2 class="block-title mono">{t.projectPage.problem}</h2>
          <p>{data.problem}</p>
        </div>
        <div class="context-item">
          <h2 class="block-title mono">{t.projectPage.audience}</h2>
          <p>{data.audience}</p>
        </div>
      </section>

      {
        data.gallery && data.gallery.length > 0 && (
          <div data-reveal>
            <ProjectGallery locale={locale} shots={data.gallery} />
          </div>
        )
      }

      <section class="project-block" data-reveal>
        <h2 class="block-title mono">{t.projectPage.responsibilities}</h2>
        <ul class="block-list" role="list">
          {data.responsibilities.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="project-block" data-reveal>
        <h2 class="block-title mono">{t.projectPage.decisions}</h2>
        <ul class="block-list" role="list">
          {data.decisions.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="project-block" data-reveal>
        <h2 class="block-title mono">{t.projectPage.outcomes}</h2>
        <ul class="block-list block-list--outcomes" role="list">
          {data.outcomes.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section class="project-block" data-reveal>
        <h2 class="block-title mono">{t.projectPage.technologies}</h2>
        <ul class="tech-list" role="list">
          {data.technologies.map((tech) => <li class="mono">{tech}</li>)}
        </ul>
      </section>
    </div>

    {
      next && (
        <nav class="project-next" aria-label={t.projectPage.nextProject}>
          <a href={projectPath(locale, next.data.slug)} class="container project-next-inner">
            <span class="mono project-next-label">{t.projectPage.nextProject}</span>
            <span class="display project-next-title">
              {next.data.title}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </span>
          </a>
        </nav>
      )
    }
  </article>
</Layout>

<style>
  .project-hero {
    padding-block: 8.5rem 4rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--theme) 10%, var(--paper)) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--line);
  }

  .project-hero-inner {
    display: grid;
    gap: 2.5rem;
    justify-items: start;
  }

  .project-back .flip {
    display: inline-block;
  }

  @media (hover: hover) {
    .project-back:hover .flip {
      transform: translateX(-4px);
    }

    .project-link:hover {
      border-color: var(--accent);
    }

    .project-next:hover .project-next-title {
      color: var(--accent);
    }

    .project-next:hover .arrow {
      transform: translateX(6px);
    }
  }

  .project-head {
    display: grid;
    gap: 1.1rem;
    max-width: 46rem;
  }

  .project-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .project-brand-text {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
  }

  .project-category {
    color: var(--theme);
    font-size: 0.7rem;
  }

  .project-title {
    font-size: clamp(2.6rem, 1.8rem + 3.6vw, 4.4rem);
    font-weight: 470;
  }

  .project-summary {
    font-size: var(--fs-lead);
    color: var(--ink-soft);
    line-height: 1.6;
    text-wrap: pretty;
  }

  .project-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 1.5rem;
    width: 100%;
    border-top: 1px solid var(--line-strong);
    padding-top: 1.6rem;
  }

  .project-meta dt {
    color: var(--ink-faint);
    font-size: 0.64rem;
    margin-bottom: 0.45rem;
  }

  .project-meta dd {
    color: var(--ink);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .project-link {
    color: var(--accent-ink);
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.25s var(--ease-out);
  }

  .project-body {
    display: grid;
    gap: 3.5rem;
    padding-block: 4.5rem;
    max-width: 52rem;
  }

  .project-context {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 2rem;
  }

  .context-item {
    display: grid;
    gap: 0.8rem;
    align-content: start;
  }

  .block-title {
    color: var(--theme);
    font-size: 0.72rem;
  }

  .project-block {
    display: grid;
    gap: 1.2rem;
  }

  .project-block p {
    color: var(--ink-soft);
    line-height: 1.7;
    text-wrap: pretty;
  }

  .block-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.8rem;
  }

  .block-list li {
    color: var(--ink-soft);
    line-height: 1.65;
    padding-left: 1.3rem;
    position: relative;
  }

  .block-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.55rem;
    height: 1px;
    background: var(--theme);
  }

  .block-list--outcomes li {
    color: var(--ink);
    font-weight: 450;
  }

  .tech-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .tech-list li {
    font-size: 0.68rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink-soft);
  }

  .project-next {
    display: block;
    border-top: 1px solid var(--line);
    background: var(--paper-sunken);
  }

  .project-next-inner {
    display: grid;
    gap: 0.8rem;
    padding-block: 3.5rem;
  }

  .project-next-label {
    color: var(--ink-faint);
    font-size: 0.68rem;
  }

  .project-next-title {
    font-size: clamp(1.8rem, 1.3rem + 2.2vw, 3rem);
    font-weight: 480;
    display: inline-flex;
    align-items: baseline;
    gap: 1rem;
    transition: color 0.3s var(--ease-out);
  }

  .project-next-title .arrow {
    transition: transform 0.3s var(--ease-out);
  }
</style>
