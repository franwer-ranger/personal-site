---
import ProjectLogo from './ProjectLogo.astro';
import { getTranslations, projectPath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<section class="section theme-dark webel" id="webel">
  <div class="container">
    <header class="section-head" data-reveal>
      <span class="section-index">01 · {t.sections.work}</span>
      <p class="kicker">{t.webel.kicker}</p>
      <div class="webel-brand">
        <ProjectLogo src="/webel/logo.png" size="md" />
        <h2 class="display section-title">{t.webel.title}</h2>
      </div>
      <p class="section-intro">{t.webel.intro}</p>
    </header>

    <div class="webel-grid">
      <p class="webel-areas-label mono" data-reveal>{t.webel.areasLabel}</p>
      <ul class="webel-areas" role="list">
        {
          t.webel.areas.map((area, i) => (
            <li class="webel-area" data-reveal data-reveal-delay={String(i * 90)}>
              <span class="area-index mono" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="area-name">{area.name}</h3>
              <p class="area-desc">{area.description}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="webel-actions" data-reveal>
      <a href={projectPath(locale, 'webel')} class="button">{t.webel.cta}</a>
      <a href="https://appwebel.com" class="link-arrow webel-visit" target="_blank" rel="noopener noreferrer">
        {t.webel.visit}
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<style>
  .webel {
    overflow: clip;
  }

  .webel-brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .webel-brand .section-title {
    margin: 0;
  }

  .webel-grid {
    display: grid;
    gap: 1.5rem;
  }

  .webel-areas-label {
    color: var(--coal-text-soft);
    font-size: 0.68rem;
  }

  .webel-areas {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    border-top: 1px solid var(--coal-line);
  }

  .webel-area {
    padding: 1.6rem 1.4rem 1.8rem 0;
    border-bottom: 1px solid var(--coal-line);
    display: grid;
    gap: 0.7rem;
    align-content: start;
    position: relative;
  }

  .webel-area::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    height: 1px;
    width: 0;
    background: var(--accent);
    transition: width 0.6s var(--ease-out);
  }

  @media (hover: hover) {
    .webel-area:hover::before {
      width: 100%;
    }

    .webel-actions .button:hover {
      background: var(--accent);
      border-color: var(--accent);
      color: var(--paper);
    }

    .webel-visit:hover {
      color: var(--accent);
      border-color: var(--accent);
    }
  }

  .area-index {
    color: var(--accent);
    font-size: 0.68rem;
  }

  .area-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .area-desc {
    color: var(--coal-text-soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .webel-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .webel-actions .button {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }

  .webel-visit {
    color: var(--coal-text);
    border-bottom-color: var(--coal-line);
  }
</style>
