---
import { getTranslations, type Locale } from '../../i18n/ui';
import { mailtoHref } from '../../lib/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).studio;
---

<section class="page cta" aria-labelledby="cta-title">
  <h2 id="cta-title">{t.cta.title}</h2>
  <p>{t.cta.text}</p>
  <a href={mailtoHref(t.contactSubject)} class="button">{t.nav.cta}</a>
</section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-6);
    padding: var(--spacing-16) var(--spacing-6);
    border-radius: var(--radius-xl);
    background: var(--color-ink);
    text-align: center;
  }

  h2 {
    max-width: var(--container-prose);
    background: linear-gradient(90deg, #ffffff, #9b9b9b);
    background-clip: text;
    color: transparent;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tighter);
    line-height: var(--leading-10);
    text-wrap: balance;
  }

  p {
    color: var(--color-text-faint);
  }

  .button {
    width: 100%;
    padding-block: var(--spacing-4);
  }

  @media (min-width: 768px) {
    .cta {
      padding: var(--spacing-20) var(--spacing-16);
    }

    h2 {
      font-size: var(--text-5xl);
      line-height: var(--leading-12);
    }

    .button {
      width: auto;
      padding-block: var(--spacing-3);
    }
  }
</style>
