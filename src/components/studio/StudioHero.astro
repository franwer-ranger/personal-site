---
import '@fontsource-variable/bricolage-grotesque';
import { Image } from 'astro:assets';
import relay from '../../assets/studio/relay.png';
import guarderia from '../../assets/studio/guarderia.png';
import { getTranslations, type Locale } from '../../i18n/ui';
import { mailtoHref } from '../../lib/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).studio;
const slots = ['10:00', '13:00', '17:30', '19:00'];
const picked = 2;
---

<section class="hero page" aria-labelledby="hero-title">
  <p class="chip enter"><span class="dot" aria-hidden="true"></span>{t.hero.chip}</p>
  <h1 id="hero-title" class="enter" style="--i: 1">{t.hero.title[0]}<br />{t.hero.title[1]}</h1>
  <p class="hero-lead enter" style="--i: 2">{t.hero.lead}</p>
  <div class="hero-actions enter" style="--i: 3">
    <a href={mailtoHref(t.contactSubject)} class="button">{t.nav.cta}</a>
    <p class="proof">{t.hero.proof}</p>
  </div>
</section>

<figure class="visual page enter" style="--i: 4" aria-label={t.visual.label}>
  <Image
    class="relay"
    src={relay}
    alt={t.visual.relayAlt}
    widths={[480, 960, 1376]}
    sizes="(min-width: 1024px) 688px, 480px"
    loading="eager"
  />
  <div class="phone">
    <Image src={guarderia} alt={t.visual.guarderiaAlt} widths={[320, 640]} sizes="(min-width: 1024px) 384px, 305px" />
  </div>
  <!-- Tarjeta con la marca de Agendao (file "Agendao" en Paper, 01 · Marca). -->
  <div class="booking" aria-hidden="true">
    <div class="salon">
      <span class="avatar">{t.visual.salonInitials}</span>
      <span class="salon-text">
        <span class="salon-name">{t.visual.salon}</span>
        <span class="salon-place">{t.visual.salonPlace}</span>
      </span>
    </div>
    <div class="service">
      <span class="service-name">{t.visual.service}</span>
      <span class="service-price">{t.visual.price}</span>
    </div>
    <ul class="slots" role="list">
      {slots.map((slot, index) => <li class:list={{ picked: index === picked }}>{slot}</li>)}
    </ul>
    <span class="sticker">{t.visual.sticker}</span>
  </div>
</figure>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-6);
    padding-block: var(--spacing-16) var(--spacing-12);
    text-align: center;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-1) var(--spacing-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-5);
  }

  .dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: var(--radius-full);
    background: var(--color-success);
  }

  h1 {
    max-width: var(--container-prose);
    background: linear-gradient(90deg, #000000, #666666);
    background-clip: text;
    color: transparent;
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tightest);
    line-height: var(--leading-10);
  }

  .hero-lead {
    max-width: var(--container-prose);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-7);
  }

  .hero-actions {
    display: flex;
    width: 100%;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-3);
    padding-top: var(--spacing-2);
  }

  .hero-actions .button {
    width: 100%;
    padding-block: var(--spacing-4);
  }

  .proof {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    line-height: var(--leading-5);
  }

  /* Composición: en móvil se monta sobre un escenario de 342 × 420 centrado;
     Relay se sale por la derecha y el contenedor lo recorta. */
  .visual {
    --stage-left: max(0px, (100% - 342px) / 2);

    position: relative;
    height: 420px;
    overflow: clip;
    border-radius: var(--radius-xl);
    background: var(--color-muted);
  }

  .visual > * {
    position: absolute;
  }

  .relay {
    top: 32px;
    left: calc(var(--stage-left) + 120px);
    width: 480px;
    max-width: none;
    height: auto;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lift);
  }

  .phone {
    top: 88px;
    left: calc(var(--stage-left) + 150px);
    width: 200px;
    aspect-ratio: 200 / 412;
    overflow: clip;
    border-radius: 32px;
    box-shadow: 0 32px 64px -24px rgb(0 0 0 / 0.35);
  }

  /* El PNG lleva margen alrededor del marco del móvil; se recorta con estos
     desplazamientos, sacados de Paper. */
  .phone img {
    position: absolute;
    top: -9.7%;
    left: -26%;
    width: 152.5%;
    max-width: none;
    height: auto;
  }

  .booking {
    --agendao-pink: #ff2e74;
    --agendao-yellow: #ffd23f;
    --agendao-gray: #f2f2f2;
    --agendao-muted: #5c5c5c;
    --agendao-display: 'Bricolage Grotesque Variable', var(--font-sans);

    top: 200px;
    left: calc(var(--stage-left) + 16px);
    display: grid;
    width: 264px;
    gap: var(--spacing-3);
    padding: var(--spacing-4);
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-xl);
    background: var(--color-bg);
    box-shadow: 6px 6px 0 var(--color-ink);
    color: var(--color-ink);
    text-align: left;
  }

  .salon {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
  }

  .avatar {
    display: grid;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    place-items: center;
    border-radius: var(--radius-full);
    background: var(--agendao-yellow);
    font-family: var(--agendao-display);
    font-size: var(--text-sm);
    font-weight: 800;
  }

  .salon-text {
    display: grid;
    gap: 2px;
  }

  .salon-name {
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-5);
  }

  .salon-place {
    color: var(--agendao-muted);
    font-size: 13px;
    line-height: var(--leading-4);
  }

  .service {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--spacing-3) var(--spacing-4);
    border-radius: var(--radius-lg);
    background: var(--agendao-gray);
  }

  .service-name {
    font-family: var(--agendao-display);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-6);
  }

  .service-price {
    font-size: 15px;
    font-weight: var(--font-weight-semibold);
  }

  .slots {
    display: flex;
    gap: var(--spacing-2);
  }

  .slots li {
    flex: 1;
    padding-block: 10px;
    border-radius: var(--radius-full);
    background: var(--agendao-gray);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: 18px;
    text-align: center;
  }

  .slots li.picked {
    background: var(--agendao-pink);
    color: #fff;
    font-weight: var(--font-weight-bold);
  }

  .slots li:last-child {
    display: none;
  }

  .sticker {
    position: absolute;
    top: -16px;
    right: -8px;
    padding: 6px var(--spacing-3);
    border-radius: var(--radius-full);
    background: var(--agendao-yellow);
    font-family: var(--agendao-display);
    font-size: 13px;
    font-weight: 800;
    line-height: var(--leading-4);
    rotate: 6deg;
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: var(--spacing-24) var(--spacing-16);
    }

    h1 {
      font-size: var(--text-6xl);
      line-height: var(--leading-15);
    }

    .hero-lead {
      font-size: var(--text-xl);
      line-height: var(--leading-7);
    }

    .hero-actions .button {
      width: auto;
      padding-block: var(--spacing-3);
    }
  }

  /* Escritorio: posiciones en porcentaje sobre el lienzo de 1248 × 560. */
  @media (min-width: 1024px) {
    .visual {
      height: auto;
      aspect-ratio: 1248 / 560;
    }

    .relay {
      top: 11.43%;
      left: 22.44%;
      width: 55.13%;
    }

    .phone {
      top: 20%;
      left: 73.72%;
      width: 20.19%;
      aspect-ratio: 252 / 520;
      border-radius: 40px;
    }

    .booking {
      top: 47%;
      left: 5.13%;
      width: 320px;
      gap: var(--spacing-4);
      padding: 20px;
    }

    .service-name {
      font-size: var(--text-xl);
      line-height: 26px;
    }

    .slots li:last-child {
      display: block;
    }

    .sticker {
      right: -14px;
    }
  }

  /* Al bajar: cada pieza se mueve a su ritmo y en Agendao se elige hora. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .visual {
        view-timeline: --visual;
      }

      .relay,
      .phone,
      .booking {
        animation: drift linear both;
        animation-timeline: --visual;
        animation-range: cover 0% cover 100%;
      }

      .relay {
        --drift: 12px;
      }

      .phone {
        --drift: 32px;
      }

      .booking {
        --drift: 20px;
      }

      .slots li.picked {
        animation: pick linear both;
        animation-timeline: --visual;
        animation-range: cover 28% cover 34%;
      }

      .sticker {
        animation: pop linear both;
        animation-timeline: --visual;
        animation-range: cover 33% cover 38%;
      }
    }
  }

  @keyframes drift {
    from {
      translate: 0 var(--drift);
    }
    to {
      translate: 0 calc(-1 * var(--drift));
    }
  }

  @keyframes pick {
    from {
      background: var(--agendao-gray);
      color: var(--color-ink);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      scale: 0.4;
      rotate: -12deg;
    }
  }
</style>
