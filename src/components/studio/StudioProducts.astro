---
import { profile } from '../../config/profile';
import { fill, getTranslations, type Locale } from '../../i18n/ui';
import { mailtoHref } from '../../lib/contact';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).studio.products;

function actionHref(item: (typeof t.items)[number]): string | null {
  if (item.kind === 'waitlist') return mailtoHref(fill(t.waitlistSubject, { product: item.name }));
  if (item.kind === 'github') return profile.github;
  return null;
}
---

<section id="productos" class="page products" aria-labelledby="products-title">
  <div class="section-head">
    <p class="kicker">{t.kicker}</p>
    <h2 id="products-title" class="products-title">{t.title}</h2>
  </div>
  <ul class="rows" role="list">
    {
      t.items.map((item) => {
        const href = actionHref(item);
        return (
          <li class="row">
            <h3>{item.name}</h3>
            <p class="lead">{item.text}</p>
            {href ? (
              <a
                class="link action"
                href={href}
                {...(item.kind === 'github' ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.action} <span aria-hidden="true">→</span>
              </a>
            ) : (
              <span class="action status">{item.action}</span>
            )}
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .products {
    display: grid;
    gap: var(--spacing-6);
    padding-block: var(--section-space) var(--spacing-8);
  }

  .products-title {
    color: var(--color-ink);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-9);
  }

  .row {
    display: grid;
    gap: var(--spacing-1);
    padding-block: 20px;
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  h3 {
    color: var(--color-ink);
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-7);
  }

  .action {
    padding-top: var(--spacing-1);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-semibold);
    line-height: var(--leading-5);
  }

  .status {
    color: var(--color-text-subtle);
  }

  @media (min-width: 768px) {
    .products {
      gap: var(--spacing-8);
      padding-bottom: var(--spacing-12);
    }

    .products-title {
      font-size: var(--text-4xl);
      line-height: var(--leading-10);
    }

    .row {
      grid-template-columns: minmax(180px, 280px) 1fr 160px;
      align-items: center;
      gap: var(--spacing-6);
      padding-block: var(--spacing-6);
    }

    h3 {
      font-size: var(--text-2xl);
      line-height: var(--leading-8);
    }

    .action {
      padding-top: 0;
      text-align: right;
    }
  }
</style>
