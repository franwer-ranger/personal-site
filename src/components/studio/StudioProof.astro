---
import { profile } from '../../config/profile';
import { getTranslations, type Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale).studio.proof;
const recommendation = profile.recommendation;
---

<section class="band">
  <div class="section page proof" aria-labelledby="proof-title">
    <div class="proof-head reveal">
      <div class="section-head">
        <p class="kicker">{t.kicker}</p>
        <h2 id="proof-title" class="title">{t.title}</h2>
      </div>
      <p class="lead intro">{t.intro}</p>
    </div>
    <div class="cards">
      {
        t.clients.map((client, index) => (
          <article class="card reveal" style={`--i: ${index}`}>
            <h3>{client.name}</h3>
            <p class="meta">{client.label}</p>
            <p class="lead text">{client.text}</p>
          </article>
        ))
      }
      {
        recommendation && (
          <figure class="card quote reveal" style={`--i: ${t.clients.length}`}>
            <blockquote class="lead text">{recommendation.quote[locale]}</blockquote>
            <figcaption class="meta">
              {recommendation.author} · {recommendation.relationship[locale]}
            </figcaption>
          </figure>
        )
      }
    </div>
  </div>
</section>

<style>
  .proof {
    display: grid;
    gap: var(--spacing-12);
  }

  .proof-head {
    display: grid;
    gap: var(--spacing-6);
  }

  .cards {
    display: grid;
    gap: var(--spacing-4);
  }

  .card {
    display: grid;
    align-content: start;
    gap: var(--spacing-4);
    min-width: 0;
    padding: var(--spacing-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg);
  }

  h3 {
    color: var(--color-ink);
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-9);
  }

  .meta {
    color: var(--color-text-subtle);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    line-height: var(--leading-5);
  }

  .text {
    color: var(--color-text);
  }

  @media (min-width: 768px) {
    .cards {
      grid-auto-columns: 1fr;
      grid-auto-flow: column;
    }

    .card {
      padding: var(--spacing-10);
    }
  }

  @media (min-width: 1024px) {
    .proof-head {
      grid-template-columns: 1fr 440px;
      align-items: end;
    }
  }
</style>
