---
import ProfessionalCasePage from '../../../components/ProfessionalCasePage.astro';
import LabProjectPage from '../../../components/LabProjectPage.astro';
import { getProjects, isLab, isProfessional, nextOfSameKind } from '../../../lib/data';

export async function getStaticPaths() {
  const projects = await getProjects('en');
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project, next: nextOfSameKind(projects, project) },
  }));
}

const { project, next } = Astro.props;
const ogImage = isProfessional(project) || project.data.slug === 'my-potential'
  ? `/og-${project.data.slug}-en.png`
  : undefined;
---

{isProfessional(project) && <ProfessionalCasePage locale="en" project={project} next={next} ogImage={ogImage} />}
{isLab(project) && <LabProjectPage locale="en" project={project} next={next} ogImage={ogImage} />}
