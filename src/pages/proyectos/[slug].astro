---
import ProfessionalCasePage from '../../components/ProfessionalCasePage.astro';
import LabProjectPage from '../../components/LabProjectPage.astro';
import { getProjects, isLab, isProfessional, nextOfSameKind } from '../../lib/data';

export async function getStaticPaths() {
  const projects = await getProjects('es');
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project, next: nextOfSameKind(projects, project) },
  }));
}

const { project, next } = Astro.props;
// Cada caso profesional tiene su propia social card; el Lab usa la general.
const ogImage = isProfessional(project) || project.data.slug === 'my-potential'
  ? `/og-${project.data.slug}-es.png`
  : undefined;
---

{isProfessional(project) && <ProfessionalCasePage locale="es" project={project} next={next} ogImage={ogImage} />}
{isLab(project) && <LabProjectPage locale="es" project={project} next={next} ogImage={ogImage} />}
